    {
      "id": "3e3ed1c1-61fc-4b65-9d12-e2558eb21e8b",
      "name": "Calcular SLA e Equipe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const inputData = $input.first().json;\nconst severityRaw = String(inputData.severity || 'Media');\nconst severity = severityRaw.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\nconst category = inputData.category || 'Outros';\nconst slaMatrix = { critica: 30, alta: 120, media: 480, baixa: 1440 };\nconst slaMinutes = slaMatrix[severity] || 480;\nlet assignedTeam = 'N1 Suporte Geral';\nlet escalationTier = 'N1_LOCAL';\nif (category === 'Acessos/Senhas') { assignedTeam = 'N2 Acessos e Identidade'; escalationTier = 'N2_AUTOMATED_REMEDIATION'; }\nelse if (category === 'Redes/VPN') { assignedTeam = 'N2 Infraestrutura e Redes'; escalationTier = 'N2_NETWORK_FAILOVER'; }\nelse if (category === 'Hardware') { assignedTeam = 'Suporte Presencial N2'; escalationTier = 'N2_ONSITE_FIELD_SERVICE'; }\nconst onCallRequired = severity === 'critica';\nif (onCallRequired) { escalationTier = 'N3_PLANTAO_IMEDIATO'; }\nconst now = new Date();\nconst deadline = new Date(now.getTime() + slaMinutes * 60000);\nreturn [{ json: {\n  subworkflow_executed: true,\n  ticket_id: inputData.ticket_id || 'TCK-UNKNOWN',\n  user_email: inputData.user_email || null,\n  category,\n  severity: severityRaw,\n  sla_target_minutes: slaMinutes,\n  sla_deadline_iso: deadline.toISOString(),\n  assigned_team: assignedTeam,\n  escalation_tier: escalationTier,\n  on_call_required: onCallRequired,\n  compliance_rule_applied: 'SOP-ITSM-POL-04',\n  calculated_at: now.toISOString()\n} }];"
      }
    },
    {
      "id": "2edf3c99-1996-41cb-9d32-75ae38c605bd",
