      "position": [880, 320]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Você é o Agente Classificador e Roteador interno do n8n (Terceiro Agente). Avalie o laudo de triagem do Agente 1:\n- Categoria: {{ $json.result.category }}\n- Severidade: {{ $json.result.severity }}\n- Requer Escalonamento: {{ $json.result.requires_human_escalation }}\n- Ação Recomendada: {{ $json.result.recommended_action }}\n\nDecida se o incidente exige acionamento do Agente 2 de Auto-Remediação para intervenção direta (desbloqueio de AD ou failover de VPN) e sintetize a diretriz de despacho.",
        "options": {
          "systemMessage": "Você é o Agente de Decisão Roteadora do n8n. Responda em JSON com os campos: 'should_remediate' (boolean), 'action_type' ('UNLOCK_ACCOUNT', 'VPN_FAILOVER', ou 'NONE') e 'rationale' (string)."
        }
      },
      "id": "node-05-third-agent-node",
      "name": "Terceiro Agente: Classificador & Roteador (#Req 8)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [1120, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-remediation-needed",
              "leftValue": "={{ $('HTTP Request - Poll Agent 1 (#Req 5)').item.json.result.category }}",
              "rightValue": "Acessos/Senhas",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-vpn-failover",
              "leftValue": "={{ $('HTTP Request - Poll Agent 1 (#Req 5)').item.json.result.category }}",
              "rightValue": "Redes/VPN",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "node-06-conditional-routing",
      "name": "Condicional de Roteamento (#Req 7)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1360, 320]
    },
