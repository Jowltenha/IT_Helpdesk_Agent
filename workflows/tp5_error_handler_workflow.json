    {
      "id": "a6056393-4146-421f-808e-38d9ec94f985",
      "name": "Montar Alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const e = $input.first().json;\nconst exec = e.execution || {};\nconst wf = e.workflow || {};\nconst err = exec.error || e.trigger?.error || {};\n// Stop and Error guarda a mensagem detalhada em messages[0]; 'message' tem o resumo do n8n\nconst detail = (Array.isArray(err.messages) && err.messages[0]) || err.description || '';\nconst message = String(detail || err.message || 'Erro sem mensagem');\nconst failedNode = exec.lastNodeExecuted || err.node?.name || 'desconhecido';\nconst m = message.match(/ticket=(\\S+)/);\nconst a = message.match(/agent=(agent[12])/);\nlet agent = a ? a[1] : 'n8n';\nif (!a && /Agente 1/i.test(failedNode)) agent = 'agent1';\nif (!a && /Agente 2/i.test(failedNode)) agent = 'agent2';\nconst agentLabel = { agent1: 'Agente 1 (Triagem N1 - porta 8001)', agent2: 'Agente 2 (Remediacao N2 - porta 8002)', n8n: 'Orquestrador n8n' }[agent];\nconst alertId = 'ALR-' + Date.now().toString(36).toUpperCase();\nconst cleanMsg = message.replace(/^AGENT_FAILURE agent=\\S+ ticket=\\S+ \\| /, '');\nconst lines = [\n  ':rotating_light: **Falha no pipeline de Helpdesk**',\n  '**Alerta:** ' + alertId,\n  '**Componente:** ' + agentLabel,\n  '**Workflow:** ' + (wf.name || '-') + ' (exec ' + (exec.id || '-') + ')',\n  '**No que falhou:** ' + failedNode,\n  '**Ticket:** ' + (m ? m[1] : '-'),\n  '**Erro:** ' + cleanMsg.slice(0, 900),\n  '**Fallback aplicado:** ticket marcado como status=error na Data Table; o chatbot exibe a falha ao usuario.',\n  exec.url ? '**Execucao:** ' + exec.url : ''\n].filter(Boolean);\nreturn [{ json: {\n  alert_id: alertId,\n  created_at: new Date().toISOString(),\n  source: exec.mode || 'trigger',\n  workflow_name: wf.name || '',\n  execution_id: String(exec.id || ''),\n  failed_node: failedNode,\n  agent,\n  ticket_id: m ? m[1] : '',\n  error_message: cleanMsg.slice(0, 1500),\n  discord_content: lines.join('\\n').slice(0, 1990)\n} }];"
      }
    },
    {
      "id": "29c64ce2-7945-4cc9-8d98-57b48f308218",
      "name": "Notificar Discord (#helpdesk-alertas)",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
