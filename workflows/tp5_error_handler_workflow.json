        "operation": "sendLegacy",
        "content": "={{ $json.discord_content }}",
        "options": {
          "username": "Helpdesk n8n - Alertas"
        }
      },
      "credentials": {
        "discordWebhookApi": {
          "id": "hdDiscordAlert01",
          "name": "Helpdesk Alertas - Discord Webhook"
        }
      },
      "onError": "continueRegularOutput",
      "webhookId": "f8170a5a-194b-47ca-a9ce-2e5044fc4d0f"
    },
