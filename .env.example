# Configuração de ambiente dos agentes de TI (copie para .env e preencha)
# O .env real NUNCA vai para o git (ver .gitignore).

# --- LLM via proxy local 9Router / Antigravity ---
OPENAI_API_KEY=sua-chave-do-9router
OPENAI_BASE_URL=http://localhost:20128/v1
MODEL_NAME=ag/claude-sonnet-4-6

# --- RAG do Agente 1 (embeddings reais servidos pelo proxy) ---
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
RAG_MIN_SIMILARITY=0.62

# --- Autenticação n8n -> agentes (header X-API-Key) ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# O MESMO valor deve ser cadastrado no n8n nas credenciais Header Auth
# "Helpdesk Agent 1 - X-API-Key" e "Helpdesk Agent 2 - X-API-Key".
AGENT1_API_TOKEN=
AGENT2_API_TOKEN=

# --- Timeouts por tarefa (segundos) ---
AGENT1_TASK_TIMEOUT_SECONDS=100
AGENT2_TASK_TIMEOUT_SECONDS=100

# --- Chatbot Chainlit ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/helpdesk-triage-tp4
N8N_STATUS_URL=http://localhost:5678/webhook/helpdesk-status
AGENT1_API_URL=http://localhost:8001
AGENT2_API_URL=http://localhost:8002
